# Gnani API key (server-side only — never exposed to the browser).
# Get it from the Gnani console: https://console.gnani.ai
GNANI_API_KEY=your-gnani-api-key

# Hugging Face token for the gated pyannote models (realtime speaker labels).
# Accept the conditions for pyannote/speaker-diarization-3.1 and
# pyannote/segmentation-3.0 first: https://huggingface.co/settings/tokens
HF_TOKEN=your-hugging-face-token

# Optional overrides
# PORT=8787
# MAX_SESSIONS_PER_IP=2
# GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream

# Google Gemini — clinical summary + transcript translation (server-side only).
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash

# Realtime speaker labels (local pyannote sidecar, see diarizer_server.py)
# DIARIZATION_ENABLED=true
# DIARIZER_URL=ws://127.0.0.1:8790
# DIARIZER_NUM_SPEAKERS=0   # 0 = auto-detect (use 2 or 3 to force a count)
# DIARIZER_VOICE_MATCH=0.55 # cosine similarity needed to treat a voice as the same speaker
