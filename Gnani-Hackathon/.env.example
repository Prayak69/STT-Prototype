# Gnani API key (server-side only — never exposed to the browser).
# Get it from the Gnani console: https://console.gnani.ai
GNANI_API_KEY=your-gnani-api-key

# Optional overrides
# PORT=8787
# MAX_SESSIONS_PER_IP=2
# GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream

# Google Gemini — clinical summary + transcript translation (server-side only).
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_MS=90000

# Optional: English translation of finished transcript segments.
# Gnani Prisma does not translate, so this uses Gemini. Leave the key empty or
# commented out to disable translation and reports; transcription works
# normally without it.
# TRANSLATION_ENABLED=true
# TRANSLATION_TIMEOUT_MS=20000
# TRANSLATION_MAX_RETRIES=1
# TRANSLATION_MAX_SEGMENTS=50
# TRANSLATION_MAX_SEGMENT_CHARS=4000
# TRANSLATION_MAX_TOTAL_CHARS=24000

# Optional: structured consultation report (on demand, from finished transcript
# text). Uses GEMINI_API_KEY by default; REPORT_MODEL falls back to GEMINI_MODEL.
# REPORT_ENABLED=true
# REPORT_MODEL=gemini-3.6-flash
# REPORT_TIMEOUT_MS=60000
# REPORT_MAX_RETRIES=1
# REPORT_MAX_SEGMENTS=400
# REPORT_MAX_SEGMENT_CHARS=8000
# REPORT_MAX_INPUT_CHARS=200000
# REPORT_CHUNK_CHARS=60000
# REPORT_MAX_OUTPUT_TOKENS=8192

# PharmaDesk Medicine Reference API (no credential required).
# PHARMADESK_BASE_URL=https://pharmadesk.accron.in/api
# PHARMADESK_TIMEOUT_MS=8000
# PHARMADESK_MAX_RETRIES=2
# PHARMADESK_DEFAULT_LIMIT=10
