{
  "name": "voice-to-text",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VoxNote — clinical transcription, translation, and summaries powered by Gnani Prisma v3.0 and Google Gemini",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch backend/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "node scripts/build.mjs --build",
    "start": "cross-env NODE_ENV=production tsx backend/server.ts",
    "typecheck": "node scripts/build.mjs",
    "test:batch": "node scripts/test-batch.mjs",
    "test:medicines": "node --import tsx scripts/test-medicines.ts",
    "test:translation": "node --import tsx scripts/test-translation.ts",
    "test:report": "node --import tsx scripts/test-report.ts",
    "preview": "vite preview --config frontend/vite.config.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
