# Hugging Face token with access to the pyannote diarization model.
# Accept the model conditions at:
# https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_your_token_here

# pyannote pipeline used for speaker labeling
# Default: pyannote/speaker-diarization-3.1 (most accurate general model).
# If 2 speakers are being split into 4, switch to:
#   PYANNOTE_MODEL=pyannote/speaker-diarization-precision
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1

# Optional: override the bundled IndicConformer ONNX assets directory
# CONFORMER_ASSETS_DIR=conformer_assets
