# Hugging Face token with access to the pyannote diarization model.
# Accept the model conditions at:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=hf_your_token_here

# pyannote pipeline used for speaker labeling
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1

# Optional: override the bundled IndicConformer ONNX assets directory
# CONFORMER_ASSETS_DIR=conformer_assets
